# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=taskflow

# Server
SERVER_PORT=8080

# pgAdmin
PGADMIN_EMAIL=admin@taskflow.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Telegram (fill in before running the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Числовая часть TELEGRAM_BOT_TOKEN до двоеточия — не секрет, нужна фронту
# для входа через oauth.telegram.org
VITE_TELEGRAM_BOT_ID=8738130486

# Публичный адрес приложения (HTTPS) — ngrok при разработке, домен в проде,
# например https://yourdomain.com. Единственное, что правится руками при
# перезапуске ngrok: из него выводятся кнопка мини-аппа в Telegram, ссылки
# в письмах-напоминаниях и колбэк Ucaller для входа по телефону.
PUBLIC_BASE_URL=

# Groq API (основной LLM-провайдер)
GROQ_API_KEY=

# JWT
JWT_SECRET=changeme-in-production
JWT_TTL_SECONDS=3600

# QA-вход (единственная демо-учётка, см. QaAuthController)
QA_LOGIN_SECRET=

# Опрос очереди напоминаний notification-worker, мс
NOTIFICATION_POLL_INTERVAL_MS=60000

# Mail (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push (VAPID) — сгенерировать один раз: npx web-push generate-vapid-keys
# Смена ключей обнуляет все существующие подписки пользователей на push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Ucaller (подтверждение номера входящим звонком для входа по телефону).
# Без ключей вход по телефону просто не появится в /auth/methods.
UCALLER_SERVICE_ID=
UCALLER_SECRET_KEY=
# Секретный отрезок пути колбэка (/api/v1/phone/inbound-webhook/<это>).
# Сгенерировать один раз: openssl rand -base64 32 | tr -d '=+/'
UCALLER_CALLBACK_SECRET=
